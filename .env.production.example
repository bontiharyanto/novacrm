APP_HOST=crm.example.com
FLYER_HOST=www.crm.example.com
MINIO_PUBLIC_HOST=files.crm.example.com
ACME_EMAIL=ops@example.com
IMAGE_TAG=latest

# Hosted Supabase (Project Settings → API). NOVACRM_* is required at Docker runtime.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NOVACRM_SUPABASE_URL=https://your-project.supabase.co
NOVACRM_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session-mode URI from Project Settings → Database. sslmode is added by migrate.sh if missing.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres

APP_URL=https://crm.example.com
EMAIL_FROM="NovaCRM <no-reply@novacrm.app>"
RESEND_API_KEY=
WHATSAPP_API_KEY=
# Header x-webhook-secret only (min 16 chars). Never use change-me-* or ?secret=
WHATSAPP_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
ALERT_WEBHOOK_SECRET=
WEBHOOK_SECRET=
WEBHOOK_TENANT_ID=11111111-1111-1111-1111-111111111111

REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
# Must match MINIO_PUBLIC_HOST (browser PUT/GET). Do not leave example.com in prod.
# Community MinIO CORS is global via MINIO_API_CORS_ALLOW_ORIGIN on the minio service (not mc cors set).
MINIO_PUBLIC_ENDPOINT=https://files.crm.example.com
MINIO_ACCESS_KEY=change-me-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=novacrm
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Ops is laptop/loopback only. Do not publish :3100 on the VPS without a token.
OPS_PORT=3100
OPS_BIND=127.0.0.1
OPS_TOKEN=

# Optional offsite backup (R2 / S3)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
